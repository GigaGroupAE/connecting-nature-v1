{
  "expo": {
    "name": "Connecting Nature",
    "slug": "connecting-nature",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/cn-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
        [
        "expo-build-properties",
      {
       "android": {
            "usesCleartextTraffic":true
          }
      }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notify.connectingnatureapp"
      
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/cn-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.notify.connectingnatureapp",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDpubq9wXVCU5nKMDsDG2ZzikdKIjW6cJU"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "960e2d66-956d-476c-a181-d6807eca91ea"
      }
    }
  }
}
