{
  "expo": {
    "name": "Connecting Nature",
    "slug": "connecting-nature",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/cn-icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notify.connectingnatureapp"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/cn-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.notify.connectingnatureapp",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyA_Z2qOzhi_6VaN1QClYYMXvE3MUnk02IY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5afefd15-9fd3-47f6-8f85-a1d17293c6e1"
      }
    }
  }
}
